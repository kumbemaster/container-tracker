# Copy this file to .env and fill in your own values. Never commit
# real keys. The app runs without any key; the AI features simply
# show as unavailable.

# Django secret key (required in production). Leave it unset for local
# use and Django will use a temporary insecure key for that run only.
DJANGO_SECRET_KEY=change-me-to-a-long-random-text

# Set to 0, false or no to turn off debug mode.
# DJANGO_DEBUG=1

# Extra hosts, comma separated (localhost and 127.0.0.1 are included).
# DJANGO_ALLOWED_HOSTS=example.com

# Your Meta API key; optional, the AI features show as unavailable
# without it.
MODEL_API_KEY=

# Optional, only for generate_pidgin with Muse Spark Open.
BASETEN_API_KEY=
